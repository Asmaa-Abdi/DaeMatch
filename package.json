{
  "name": "daematch",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:api": ".venv/bin/python backend/manage.py runserver 0.0.0.0:8000",
    "dev:web": "pnpm --filter daematch-frontend dev",
    "build": "pnpm --filter daematch-frontend build",
    "check": "pnpm --filter daematch-frontend typecheck && .venv/bin/python backend/manage.py check",
    "migrate": ".venv/bin/python backend/manage.py migrate",
    "makemigrations": ".venv/bin/python backend/manage.py makemigrations"
  }
}
