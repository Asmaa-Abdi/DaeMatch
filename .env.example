# Local development only. Set Railway's PostgreSQL DATABASE_URL in its protected Variables panel.
DEBUG=true
SECRET_KEY=replace-this-local-development-key-before-deploying
DATABASE_URL=postgresql://daematch:GENERATED_BY_LOCAL_SETUP@127.0.0.1:5432/daematch
DB_SSL_REQUIRE=false
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Browser origin used in password-reset and application notification emails; set the exact Vercel origin in production.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT=3600
DEFAULT_FROM_EMAIL=DAEMatch <no-reply@example.com>

# Without OAuth2 credentials or EMAIL_HOST, local preview prints reset and application notification emails to the Django console.
# When all three Google OAuth values are set, Django uses the Gmail API with the send-only gmail.send scope.
# Otherwise, EMAIL_HOST selects generic SMTP; without either provider, the console backend is used.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Set this in Vercel to the public Railway backend URL, without a trailing slash.
VITE_API_BASE_URL=
